package polymorph:iroh-demo@0.0.1;

/// The endpoint demo: one echo exchange between two processes, driven
/// entirely through the `polymorph:iroh` endpoint surface. Demo plumbing, not
/// a designed interface.
interface demo {
    /// Which side this process drives.
    enum role { client, server }

    /// One run's inputs.
    record run-config {
        /// The iroh relay server's base URL, e.g. `http://127.0.0.1:3340`.
        relay-url: string,
        /// This process's role.
        role: role,
        /// The server peer's endpoint ID (hex). Required on the client.
        peer: option<string>,
        /// The ALPN the client offers, overriding the demo's own —
        /// a failure-path probe knob (an ALPN the server does not serve
        /// must fail the handshake, not connect).
        alpn: option<string>,
        /// The `ip:port` to bind the endpoint's UDP socket to. The
        /// bound address is written to stdout as `direct-addr <ip:port>`
        /// after binding.
        udp-bind: option<string>,
        /// A direct `ip:port` for the server peer. The client adds it
        /// to the peer's address ahead of the relay entry, so the
        /// connection prefers the UDP path.
        direct: option<string>,
        /// Enables the WebRTC wire. The server answers signaling; the
        /// client also adds a `webrtc` entry to the peer's address and
        /// waits for the connection's path to reach the channel before
        /// sending, so the echo exercises the upgraded path.
        webrtc: bool,
        /// The server peer's relay URL, when it differs from this
        /// process's own (`relay-url` stays the home relay). The
        /// client dials and signals through this relay.
        peer-relay: option<string>,
        /// Replace the client's message with this many zero bytes: a
        /// bulk transfer for throughput measurement. The echo still
        /// round-trips the full payload; `roundtrip-ms` then measures
        /// bulk transfer, not latency.
        payload-bytes: option<u64>,
        /// Also exchange one datagram echo after the stream echo: the
        /// client sends a small datagram (duplicated against loss) and
        /// asserts the server's echo. Exercises `send-datagram` /
        /// `recv-datagram` end to end.
        datagram: bool,
        /// Construct the endpoint's identity from webcrypto key handles
        /// minted in this component (exercising `identity-from-keys`)
        /// instead of through `identity-generate`. Either way the demo
        /// fails unless the endpoint reports the constructed identity's
        /// public key as its `endpoint-id`.
        inject-identity: bool,
        /// Probe the identity constructor's failure paths instead of
        /// running the echo: `identity-from-keys` must reject a
        /// mismatched Ed25519 pair and a non-Ed25519 (ECDSA) pair with
        /// `invalid-argument`, and must accept a matched control pair.
        /// The run binds nothing and needs no relay or peer.
        identity-negative: bool,
        /// The application message the client sends (the server echoes it).
        message: string,
    }

    /// One run's outcome.
    record run-report {
        /// This endpoint's identity, hex-encoded.
        endpoint-id: string,
        /// The authenticated peer's identity, hex-encoded.
        peer-id: string,
        /// The wire carrying the connection when the exchange finished
        /// (`relay`, `ip`, or `webrtc`).
        path: string,
        /// Milliseconds from starting `connect` to it resolving. Zero on
        /// the server.
        handshake-ms: u64,
        /// Milliseconds from sending the message to reading the echo.
        /// Zero on the server.
        roundtrip-ms: u64,
        /// The application payload this side received.
        received: string,
        /// The datagram payload this side received, when `datagram` ran.
        datagram: option<string>,
    }

    /// Drive one full run. The process's own endpoint ID is written to
    /// stdout as `endpoint-id <hex>` after binding, so a driver can hand
    /// it to the peer.
    run: async func(config: run-config) -> result<run-report, string>;
}

world iroh-demo {
    import polymorph:iroh/endpoint@0.1.0;
    import polymorph:iroh/identity-generate@0.1.0;
    import polymorph:iroh/identity-from-keys@0.1.0;
    import wasi:clocks/monotonic-clock@0.3.0;
    export demo;
}
